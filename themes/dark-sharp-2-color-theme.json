{
  "$schema": "vscode://schemas/color-theme",
  "name": "Dark Sharp 2",
  "type": "dark",
  "colors": {
    "activityBarBadge.background": "#007acc",
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "editor.inactiveSelectionBackground": "#3a3d41",
    "editor.selectionHighlightBackground": "#add6ff26",
    "input.placeholderForeground": "#a6a6a6",
    "list.dropBackground": "#383b3d",
    "menu.background": "#252526",
    "menu.foreground": "#cccccc",
    "sideBarSectionHeader.background": "#00000000",
    "sideBarSectionHeader.border": "#cccccc33",
    "sideBarTitle.foreground": "#bbbbbb",
    "statusBarItem.remoteBackground": "#16825d",
    "statusBarItem.remoteForeground": "#ffffff",
    "tab.lastPinnedBorder": "#cccccc33"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    // ═══ Font-style channels (orthogonal) ═══
    // italic = compile-time / meta · bold = declaration / structural anchor
    // underline = static · strikethrough = deprecated
    "*.deprecated": { "strikethrough": true },
    "*.static": { "underline": true },
    "*.defaultLibrary": { "italic": true },

    // ═══ Global (language-agnostic) ═══
    "namespace": { "foreground": "#C8C8C8" },
    "module": { "foreground": "#C8C8C8" },
    "comment": { "foreground": "#757882" },
    "string": { "foreground": "#CDA48C" },
    "number": { "foreground": "#AEEA00" },
    "regexp": { "foreground": "#D16969" },
    "operator": { "foreground": "#FFD54F" },
    "keyword": { "foreground": "#569CD6" },
    "label": { "foreground": "#C8C8C8" },

    // ═══ C# — Roslyn (cannot bleed into TS) ═══
    // ── types ──
    "class:csharp": { "foreground": "#4EC9B0" },
    "recordClass:csharp": { "foreground": "#4EC9B0", "bold": true },
    "struct:csharp": { "foreground": "#86C691" },
    "recordStruct:csharp": { "foreground": "#ABB7FF", "bold": true },
    "interface:csharp": { "foreground": "#B8D7A3", "italic": true }, // contracts are meta
    "enum:csharp": { "foreground": "#B8D7A3", "bold": true },
    "type:csharp": { "foreground": "#C8C8C8", "italic": true }, // alias ≠ interface/enum
    "typeParameter:csharp": { "foreground": "#D7BA7D", "italic": true },
    "delegate:csharp": { "foreground": "#FFECB3", "italic": true },

    // ── values / members ──
    "variable:csharp": { "foreground": "#9CDCFE" },
    "variable.readonly:csharp": { "foreground": "#4FC1FF" },
    "parameter:csharp": { "foreground": "#9CDCFE", "italic": true },
    "field:csharp": { "foreground": "#9CDCFE", "bold": true },
    "field.readonly:csharp": { "foreground": "#4FC1FF", "bold": true },
    "constant:csharp": { "foreground": "#FFAB40", "bold": true }, // const ≠ readonly at a glance
    "property:csharp": { "foreground": "#26C6DA" },
    "property.readonly:csharp": { "foreground": "#4FC1FF" },
    "enumMember:csharp": { "foreground": "#92DDE2" }, // no longer shares teal with class
    "event:csharp": { "foreground": "#CE93D8", "bold": true },

    // ── callables ──
    "method:csharp": { "foreground": "#FFECB3" },
    "function:csharp": { "foreground": "#FFECB3", "italic": true }, // local functions ≠ methods
    "extensionMethod:csharp": { "foreground": "#FFECB3", "bold": true },

    // ── keywords / operators ──
    "controlKeyword:csharp": { "foreground": "#CE93D8", "italic": true },
    "operatorOverloaded:csharp": { "foreground": "#EC407A", "italic": true }, // overloaded ops pop

    // ── literals / misc ──
    "stringVerbatim": { "foreground": "#CDA48C", "italic": true },
    "stringEscapeCharacter": { "foreground": "#D7BA7D", "bold": true }, // escapes anchor in strings
    "excludedCode": { "foreground": "#5A5D66" },
    "preprocessorText": { "foreground": "#CDA48C" },

    // ── XML doc comments (grey-blue ladder above comment grey) ──
    "xmlDocCommentText": { "foreground": "#8A8E99" },
    "xmlDocCommentName": { "foreground": "#6B87A0" },
    "xmlDocCommentDelimiter": { "foreground": "#616875" },
    "xmlDocCommentAttributeName": { "foreground": "#7FA3BF" },
    "xmlDocCommentAttributeQuotes": { "foreground": "#616875" },
    "xmlDocCommentAttributeValue": { "foreground": "#94806E" },
    "xmlDocCommentComment": { "foreground": "#757882" },
    "xmlDocCommentCDataSection": { "foreground": "#757882" },
    "xmlDocCommentEntityReference": { "foreground": "#7FA3BF" },
    "xmlDocCommentProcessingInstruction": { "foreground": "#616875" },

    // ── regex-in-string (mirrors TextMate regex rules) ──
    "regexText": { "foreground": "#D16969" },
    "regexCharacterClass": { "foreground": "#D16969" },
    "regexAnchor": { "foreground": "#FFECB3" },
    "regexAlternation": { "foreground": "#FFECB3" },
    "regexQuantifier": { "foreground": "#D7BA7D" },
    "regexGrouping": { "foreground": "#CDA48C" },
    "regexComment": { "foreground": "#757882" },
    "regexSelfEscapedCharacter": { "foreground": "#D16969" },
    "regexOtherEscape": { "foreground": "#D7BA7D" },

    // ── JSON-in-string ──
    "jsonPropertyName": { "foreground": "#9CDCFE" },
    "jsonString": { "foreground": "#CDA48C" },
    "jsonNumber": { "foreground": "#AEEA00" },
    "jsonKeyword": { "foreground": "#FFAB40" },
    "jsonComment": { "foreground": "#757882" },
    "jsonConstructorName": { "foreground": "#4EC9B0" },

    // ═══ Razor / Blazor (token names globally unique) ═══
    "razorComponentElement": { "foreground": "#4EC9B0", "bold": true },
    "razorTagHelperElement": { "foreground": "#4EC9B0", "bold": true },
    "razorComponentAttribute": { "foreground": "#26C6DA", "italic": true },
    "razorTagHelperAttribute": { "foreground": "#26C6DA", "italic": true },
    "razorDirective": { "foreground": "#CE93D8", "italic": true },
    "razorDirectiveAttribute": { "foreground": "#CE93D8", "italic": true },
    "razorDirectiveColon": { "foreground": "#808080" },
    "razorTransition": { "foreground": "#F48FB1", "bold": true },
    "razorComment": { "foreground": "#757882" },

    // ═══ TypeScript — Angular class code (members read as members; cyan is
    //     reserved for data-shape keys via TextMate object-literal rules) ═══
    "class:typescript": { "foreground": "#4EC9B0" },
    "interface:typescript": { "foreground": "#B8D7A3" },
    "enum:typescript": { "foreground": "#B8D7A3", "bold": true },
    "enumMember:typescript": { "foreground": "#4EC9B0" },
    "type:typescript": { "foreground": "#B8D7A3", "italic": true },
    "typeParameter:typescript": { "foreground": "#D7BA7D", "italic": true },
    "variable:typescript": { "foreground": "#9CDCFE" },
    "variable.readonly:typescript": { "foreground": "#4FC1FF" },
    "parameter:typescript": { "foreground": "#9CDCFE", "italic": true },
    "property:typescript": { "foreground": "#26C6DA" }, // VS-style cyan members
    "property.readonly:typescript": { "foreground": "#4FC1FF" },
    "function:typescript": { "foreground": "#FFECB3" },
    "method:typescript": { "foreground": "#FFECB3" },
    "decorator:typescript": { "foreground": "#F48FB1", "italic": true } // framework magic is pink
  },
  "tokenColors": [
    // ═══════════════════════════════════════════════════════════════════
    // Layer 2 — Angular templates (external .html and inline templates)
    // ═══════════════════════════════════════════════════════════════════
    {
      "name": "Angular property binding [prop]",
      "scope": "entity.other.ng-binding-name.property",
      "settings": { "foreground": "#4FC1FF", "fontStyle": "italic" }
    },
    {
      "name": "Angular event binding (event)",
      "scope": "entity.other.ng-binding-name.event",
      "settings": { "foreground": "#FFECB3", "fontStyle": "italic" }
    },
    {
      "name": "Angular two-way binding [(model)]",
      "scope": "entity.other.ng-binding-name.two-way",
      "settings": { "foreground": "#92DDE2", "fontStyle": "italic" }
    },
    {
      "name": "Angular structural directive *ngIf / template binding",
      "scope": "entity.other.ng-binding-name.template",
      "settings": { "foreground": "#CE93D8", "fontStyle": "italic bold" }
    },
    {
      "name": "Angular attribute binding [attr.x]",
      "scope": "entity.other.ng-binding-name.attribute",
      "settings": { "foreground": "#9CDCFE", "fontStyle": "italic" }
    },
    {
      "name": "Angular class/style bindings [class.x] [style.x] (CSS-flavored gold)",
      "scope": ["entity.other.ng-binding-name.class", "entity.other.ng-binding-name.style"],
      "settings": { "foreground": "#D7BA7D", "fontStyle": "italic" }
    },
    {
      "name": "Angular binding delimiters [ ] ( ) [( )]",
      "scope": "punctuation.definition.ng-binding-name",
      "settings": { "foreground": "#FFD54F" }
    },
    {
      "name": "Angular pipe name",
      "scope": "entity.name.function.pipe.ng",
      "settings": { "foreground": "#FFECB3", "fontStyle": "italic" }
    },
    {
      "name": "Angular control-flow blocks @if/@for/@defer",
      "scope": ["keyword.control.block.kind.ng", "storage.type.ng", "keyword.control.track.ng"],
      "settings": { "foreground": "#CE93D8", "fontStyle": "italic bold" }
    },
    {
      "name": "Angular block transition @ (escape into template logic)",
      "scope": "keyword.control.block.transition.ng",
      "settings": { "foreground": "#F48FB1", "fontStyle": "bold" }
    },
    {
      "name": "Angular control-flow block braces",
      "scope": "control.block.ng punctuation.definition.block",
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Angular interpolation delimiters {{ }}",
      "scope": [
        "punctuation.definition.interpolation.begin.ng",
        "punctuation.definition.interpolation.end.ng"
      ],
      "settings": { "foreground": "#F48FB1", "fontStyle": "bold" }
    },
    {
      "name": "Component / unknown custom tags",
      "scope": ["meta.tag.custom entity.name.tag", "meta.tag.other.unrecognized entity.name.tag"],
      "settings": { "foreground": "#4EC9B0", "fontStyle": "bold" }
    },
    {
      "name": "Angular host binding (static)",
      "scope": "hostbinding.static.ng entity.other.attribute-name.html",
      "settings": { "foreground": "#9CDCFE", "fontStyle": "italic" }
    },
    {
      "name": "Angular host bindings",
      "scope": "hostbindings.ng entity.other.attribute-name.html",
      "settings": { "foreground": "#4FC1FF", "fontStyle": "italic" }
    },
    {
      "name": "Angular template reference variable / @let constant",
      "scope": "variable.other.constant.ng",
      "settings": { "foreground": "#4FC1FF" }
    },
    {
      "name": "Unrecognized attributes (likely directive inputs)",
      "scope": "meta.attribute.unrecognized entity.other.attribute-name.html",
      "settings": { "foreground": "#4FC1FF", "fontStyle": "italic" }
    },

    // ═══════════════════════════════════════════════════════════════════
    // Layer 3 — darkpp-faithful fallback (generic languages)
    // ═══════════════════════════════════════════════════════════════════
    {
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": { "foreground": "#D4D4D4" }
    },
    { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
    { "scope": "strong", "settings": { "fontStyle": "bold" } },
    { "scope": "header", "settings": { "foreground": "#000080" } },
    { "scope": "comment", "settings": { "foreground": "#757882" } },
    { "scope": "constant.language", "settings": { "foreground": "#FFAB40" } },
    {
      "scope": [
        "constant.numeric",
        "variable.other.enummember",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent"
      ],
      "settings": { "foreground": "#AEEA00" }
    },
    { "scope": "constant.regexp", "settings": { "foreground": "#646695" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#569CD6" } },
    { "scope": "entity.name.tag.css", "settings": { "foreground": "#D7BA7D" } },
    {
      "name": "Attribute names (darkpp italic restored)",
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#9CDCFE", "fontStyle": "italic" }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.mixin.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css.less entity.other.attribute-name.id",
        "entity.other.attribute-name.scss"
      ],
      "settings": { "foreground": "#D7BA7D" }
    },
    { "scope": "invalid", "settings": { "foreground": "#F44747" } },
    { "scope": "markup.underline", "settings": { "fontStyle": "underline" } },
    { "scope": "markup.bold", "settings": { "foreground": "#569CD6", "fontStyle": "bold" } },
    { "scope": "markup.heading", "settings": { "foreground": "#569CD6", "fontStyle": "bold" } },
    { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
    { "scope": "markup.inserted", "settings": { "foreground": "#AEEA00" } },
    { "scope": "markup.deleted", "settings": { "foreground": "#CDA48C" } },
    { "scope": "markup.changed", "settings": { "foreground": "#569CD6" } },
    {
      "scope": "punctuation.definition.quote.begin.markdown",
      "settings": { "foreground": "#757882" }
    },
    {
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": { "foreground": "#6796E6" }
    },
    { "scope": "markup.inline.raw", "settings": { "foreground": "#CDA48C" } },
    { "scope": "punctuation.definition.tag", "settings": { "foreground": "#808080" } },
    {
      "scope": ["meta.preprocessor", "entity.name.function.preprocessor"],
      "settings": { "foreground": "#569CD6" }
    },
    { "scope": "meta.preprocessor.string", "settings": { "foreground": "#CDA48C" } },
    { "scope": "meta.preprocessor.numeric", "settings": { "foreground": "#AEEA00" } },
    { "scope": "meta.structure.dictionary.key.python", "settings": { "foreground": "#9CDCFE" } },
    { "scope": "meta.diff.header", "settings": { "foreground": "#569CD6" } },
    { "scope": "storage", "settings": { "foreground": "#569CD6" } },
    { "scope": "storage.type", "settings": { "foreground": "#569CD6", "fontStyle": "italic" } },
    {
      "scope": ["storage.modifier", "keyword.operator.noexcept"],
      "settings": { "foreground": "#569CD6", "fontStyle": "italic" }
    },
    { "scope": ["string", "meta.embedded.assembly"], "settings": { "foreground": "#CDA48C" } },
    { "scope": ["string.tag", "string.value"], "settings": { "foreground": "#CDA48C" } },
    { "scope": "string.regexp", "settings": { "foreground": "#D16969" } },
    {
      "name": "Template expression escape ${ } (matches Razor @ and ng {{ }})",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#F48FB1", "fontStyle": "bold" }
    },
    { "scope": "meta.template.expression", "settings": { "foreground": "#D4D4D4" } },
    {
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "variable.css",
        "variable.scss",
        "variable.other.less",
        "source.coffee.embedded"
      ],
      "settings": { "foreground": "#9CDCFE" }
    },
    { "scope": "keyword", "settings": { "foreground": "#569CD6" } },
    {
      "name": "Control keywords (darkpp purple italic)",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.operator",
        "entity.name.operator"
      ],
      "settings": { "foreground": "#CE93D8", "fontStyle": "italic" }
    },
    {
      "name": "Flow keywords return/await/yield pop pink (darkpp restored)",
      "scope": "keyword.control.flow",
      "settings": { "foreground": "#F48FB1", "fontStyle": "italic" }
    },
    { "scope": "keyword.operator", "settings": { "foreground": "#FFD54F" } },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.alignas",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": { "foreground": "#FFD54F", "fontStyle": "italic" }
    },
    {
      "name": "Logical operators / optional chaining (darkpp restored)",
      "scope": ["keyword.operator.logical", "punctuation.accessor.optional"],
      "settings": { "foreground": "#EC407A" }
    },
    { "scope": "keyword.other.unit", "settings": { "foreground": "#AEEA00" } },
    {
      "scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"],
      "settings": { "foreground": "#569CD6" }
    },
    { "scope": "support.function.git-rebase", "settings": { "foreground": "#9CDCFE" } },
    { "scope": "constant.sha.git-rebase", "settings": { "foreground": "#AEEA00" } },
    {
      "scope": [
        "storage.modifier.import.java",
        "variable.language.wildcard.java",
        "storage.modifier.package.java"
      ],
      "settings": { "foreground": "#D4D4D4" }
    },
    {
      "scope": "variable.language",
      "settings": { "foreground": "#569CD6", "fontStyle": "italic" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal"
      ],
      "settings": { "foreground": "#FFECB3" }
    },
    {
      "scope": [
        "meta.return-type",
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": { "foreground": "#4EC9B0" }
    },
    {
      "scope": [
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#4EC9B0" }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "meta.decorator variable.other.readwrite"
      ],
      "settings": { "foreground": "#9CDCFE" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#4FC1FF" }
    },
    {
      "name": "Data-shape keys stay cyan (object literals, JSON-ish)",
      "scope": [
        "meta.object-literal.key",
        "meta.object-literal.key entity.name.function",
        "variable.other.object.property",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#26C6DA" }
    },
    {
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": { "foreground": "#CDA48C" }
    },
    {
      "scope": [
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "keyword.operator.negation.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": { "foreground": "#CDA48C" }
    },
    {
      "scope": [
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp"
      ],
      "settings": { "foreground": "#D16969" }
    },
    {
      "scope": ["keyword.operator.or.regexp", "keyword.control.anchor.regexp"],
      "settings": { "foreground": "#FFECB3" }
    },
    { "scope": "keyword.operator.quantifier.regexp", "settings": { "foreground": "#D7BA7D" } },
    { "scope": "constant.character", "settings": { "foreground": "#569CD6" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#D7BA7D" } },
    { "scope": "entity.name.label", "settings": { "foreground": "#C8C8C8" } },
    { "scope": "token.info-token", "settings": { "foreground": "#6796E6" } },
    { "scope": "token.warn-token", "settings": { "foreground": "#CD9731" } },
    { "scope": "token.error-token", "settings": { "foreground": "#F44747" } },
    { "scope": "token.debug-token", "settings": { "foreground": "#B267E6" } },
    {
      "name": "@Decorator",
      "scope": ["meta.decorator punctuation.decorator"],
      "settings": { "foreground": "#FFECB3", "fontStyle": "italic" }
    },
    { "scope": "keyword.generator.asterisk", "settings": { "foreground": "#FFD54F" } },
    { "scope": "storage.type.function.arrow", "settings": { "fontStyle": "" } }
  ]
}
